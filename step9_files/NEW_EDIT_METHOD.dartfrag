  String? _statusUpdatingUid;

  Future<void> _changeStatus(StaffProfile person, String next) async {
    if (next == person.status || _statusUpdatingUid != null) return;
    final action = next == 'active' ? 'Activate' : next == 'suspended' ? 'Suspend' : 'Mark Inactive';
    final approved = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text('$action ${person.fullName}?'),
        content: Text(next == 'active'
            ? 'This enables the employee’s read-only Staff Portal after email verification. Training and shift-based operating permissions remain separate.'
            : 'This blocks the employee’s Staff Portal access while keeping their records and training history. It does not delete the Firebase login account.'),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('Cancel')),
          FilledButton(onPressed: () => Navigator.pop(ctx, true), child: Text(action)),
        ],
      ),
    );
    if (approved != true || !mounted) return;
    setState(() => _statusUpdatingUid = person.uid);
    try {
      await widget.repository.saveStaffProfile(
        uid: person.uid,
        fullName: person.fullName,
        email: person.email,
        status: next,
        eligibleRoles: person.eligibleRoles,
      );
      if (mounted) setState(() {
        notice = '${person.fullName} is now ${next.toUpperCase()}.';
        error = null;
      });
    } catch (e) {
      if (mounted) setState(() => error = _message(e));
    } finally {
      if (mounted) setState(() => _statusUpdatingUid = null);
    }
  }

  Widget _statusControl(StaffProfile person) {
    if (_statusUpdatingUid == person.uid) {
      return const SizedBox(width: 28, height: 28,
        child: CircularProgressIndicator(strokeWidth: 2));
    }
    final statusColor = person.status == 'active'
        ? const Color(0xFF26734D)
        : person.status == 'suspended'
            ? const Color(0xFFB42318)
            : const Color(0xFF96651C);
    final statusLabel = person.status == 'active' ? 'Active'
        : person.status == 'suspended' ? 'Suspended' : 'Inactive';
    return PopupMenuButton<String>(
      tooltip: 'Change status for ${person.fullName}',
      enabled: _statusUpdatingUid == null,
      onSelected: (value) => _changeStatus(person, value),
      itemBuilder: (context) => [
        for (final status in const ['active', 'inactive', 'suspended'])
          PopupMenuItem<String>(
            value: status,
            enabled: status != person.status,
            child: Row(children: [
              Icon(status == 'active' ? Icons.check_circle_outline
                : status == 'suspended' ? Icons.block_outlined
                : Icons.pause_circle_outline, size: 18),
              const SizedBox(width: 10),
              Text(status == 'active' ? 'Active'
                : status == 'suspended' ? 'Suspended' : 'Inactive'),
              if (status == person.status) ...[
                const Spacer(),
                const Icon(Icons.check, size: 16),
              ],
            ]),
          ),
      ],
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
        decoration: BoxDecoration(
          color: statusColor.withValues(alpha: .08),
          border: Border.all(color: statusColor.withValues(alpha: .24)),
          borderRadius: BorderRadius.circular(7),
        ),
        child: Row(mainAxisSize: MainAxisSize.min, children: [
          Text(statusLabel, style: TextStyle(
            fontSize: 12, fontWeight: FontWeight.w600, color: statusColor)),
          const SizedBox(width: 6),
          Icon(Icons.keyboard_arrow_down, size: 17, color: statusColor),
        ]),
      ),
    );
  }

  Future<void> _editStaff(StaffProfile existing) async {
    final formKey = GlobalKey<FormState>();
    final name = TextEditingController(text: existing.fullName);
    final roles = <StaffRole>{...existing.eligibleRoles};
    String? formError;
    var busy = false;
    try {
      await showDialog<void>(
        context: context,
        builder: (dialogContext) => StatefulBuilder(
          builder: (context, update) => Dialog(
            backgroundColor: Colors.white,
            insetPadding: const EdgeInsets.symmetric(horizontal: 20, vertical: 20),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
            child: SizedBox(
              width: math.min(600.0, MediaQuery.sizeOf(context).width - 44.0),
              height: math.min(560.0, MediaQuery.sizeOf(context).height - 48.0),
              child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                Padding(
                  padding: const EdgeInsets.fromLTRB(28, 24, 28, 16),
                  child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                    const Text('Edit Staff Details & Roles', style: TextStyle(
                      fontSize: 24, fontWeight: FontWeight.w700, color: adminDark)),
                    const SizedBox(height: 5),
                    Text(existing.email, style: const TextStyle(fontSize: 13, color: adminMuted)),
                  ]),
                ),
                const Divider(height: 1, color: adminBorder),
                Expanded(child: SingleChildScrollView(
                  padding: const EdgeInsets.fromLTRB(28, 22, 28, 14),
                  child: Form(
                    key: formKey,
                    autovalidateMode: AutovalidateMode.onUserInteraction,
                    child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                      const Text('Full name *', style: TextStyle(
                        fontSize: 13, fontWeight: FontWeight.w600, color: adminDark)),
                      const SizedBox(height: 8),
                      TextFormField(
                        key: const Key('staff-edit-name'),
                        controller: name,
                        enabled: !busy,
                        validator: StaffFormValidation.fullName,
                        decoration: const InputDecoration(prefixIcon: Icon(Icons.person_outline)),
                      ),
                      const SizedBox(height: 12),
                      const Text('Email is linked to Firebase Authentication and cannot be edited here.',
                        style: TextStyle(fontSize: 12, color: adminMuted)),
                      const SizedBox(height: 20),
                      const Text('Eligible roles', style: TextStyle(
                        fontSize: 15, fontWeight: FontWeight.w700, color: adminDark)),
                      const SizedBox(height: 10),
                      _StaffRolePicker(
                        roles: roles,
                        enabled: !busy,
                        onToggle: (role, selected) => update(() {
                          if (selected) { roles.add(role); } else { roles.remove(role); }
                        }),
                      ),
                      const SizedBox(height: 12),
                      const Text('Change account status using the Status button in the staff directory. Roles do not grant shift or training permission.',
                        style: TextStyle(fontSize: 12, color: adminMuted, height: 1.4)),
                      if (formError != null) Padding(
                        padding: const EdgeInsets.only(top: 10),
                        child: Text(formError!, style: const TextStyle(color: Color(0xFFB42318))),
                      ),
                    ]),
                  ),
                )),
                const Divider(height: 1, color: adminBorder),
                Padding(
                  padding: const EdgeInsets.fromLTRB(28, 14, 28, 18),
                  child: Row(mainAxisAlignment: MainAxisAlignment.end, children: [
                    TextButton(onPressed: busy ? null : () => Navigator.pop(dialogContext),
                      child: const Text('Cancel')),
                    const SizedBox(width: 10),
                    AdminButton(busy ? 'Saving...' : 'Save Changes',
                      onPressed: busy ? null : () async {
                        if (!(formKey.currentState?.validate() ?? false)) return;
                        update(() { busy = true; formError = null; });
                        try {
                          await widget.repository.saveStaffProfile(
                            uid: existing.uid,
                            fullName: name.text.trim(),
                            email: existing.email,
                            status: existing.status,
                            eligibleRoles: roles,
                          );
                          if (dialogContext.mounted) Navigator.pop(dialogContext);
                          if (mounted) setState(() {
                            selectedUid = existing.uid;
                            error = null;
                            notice = 'Updated ${existing.fullName}.';
                          });
                        } catch (e) {
                          if (dialogContext.mounted) update(() => formError = _message(e));
                        } finally {
                          if (dialogContext.mounted) update(() => busy = false);
                        }
                      },
                    ),
                  ]),
                ),
              ]),
            ),
          ),
        ),
      );
    } finally {
      name.dispose();
    }
  }

