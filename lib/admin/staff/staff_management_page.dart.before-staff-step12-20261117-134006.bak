import 'dart:async';

import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter/material.dart';

import '../admin_widgets.dart';
import 'staff_access.dart';
import 'staff_dialog_frame.dart';
import 'staff_email_check.dart';
import 'staff_form_validation.dart';
import 'staff_onboarding_repository.dart';
import 'staff_records.dart';
import 'staff_records_repository.dart';
import 'staff_training_catalog.dart';

/// Workforce administration on Firebase Spark. Restricted staff are never
/// granted the legacy admin claim or an operational permission by this UI.
class StaffManagementPage extends StatefulWidget {
  const StaffManagementPage({super.key, required this.repository});
  final StaffRecordsRepository repository;

  @override
  State<StaffManagementPage> createState() => _StaffManagementPageState();
}

class _StaffManagementPageState extends State<StaffManagementPage> {
  final searchController = TextEditingController();
  late final StaffOnboardingRepository _onboarding = StaffOnboardingRepository();
  late final StaffTrainingCatalogRepository _catalog =
      StaffTrainingCatalogRepository(widget.repository.db);
  late final Stream<List<StaffProfile>> _staffStream =
      widget.repository.watchStaffDirectory();
  late final Stream<QuerySnapshot<Map<String, dynamic>>> _proofStream =
      widget.repository.db.collection('staffEmailVerifications').snapshots();

  String search = '';
  String statusFilter = 'all';
  String? selectedUid;
  String? error;
  String? notice;
  String? statusBusyUid;
  List<StaffProfile> _lastDirectory = const [];

  @override
  void dispose() {
    searchController.dispose();
    super.dispose();
  }

  String _message(Object e) {
    final value = e.toString().toLowerCase();
    if (value.contains('email-already-in-use') ||
        value.contains('already-exists') ||
        value.contains('already belongs to a staff account')) {
      return 'This email is already in use.';
    }
    if (value.contains('permission-denied') ||
        value.contains('not authorized') || value.contains('unauthenticated')) {
      return 'You don\'t have permission to do this.';
    }
    if (value.contains('network') || value.contains('unavailable')) {
      return 'Connection failed. Try again.';
    }
    if (value.contains('too-many-requests')) {
      return 'Too many attempts. Try again later.';
    }
    if (value.contains('may exist without a staff profile')) {
      return 'Account created, but details could not be saved. Contact support.';
    }
    if (value.contains('operation-not-allowed')) {
      return 'Account registration is unavailable.';
    }
    if (value.contains('course with this name already exists')) {
      return 'This course already exists.';
    }
    if (value.contains('course name must be')) {
      return 'Enter a valid course name.';
    }
    if (e is ArgumentError) {
      final message = e.message?.toString() ?? '';
      if (message.startsWith('Enter ') || message.startsWith('Select ') ||
          message.startsWith('Choose ') || message.startsWith('Set ') ||
          message.startsWith('This ') || message.startsWith('Training ')) {
        return message;
      }
      return 'Check the information and try again.';
    }
    return 'Couldn\'t save changes. Try again.';
  }

  void _notify(String value, {bool failure = false}) {
    if (!mounted) return;
    setState(() {
      if (failure) {
        error = value;
      } else {
        notice = value;
        error = null;
      }
    });
  }

  Future<void> _createStaff() async {
    final form = GlobalKey<FormState>();
    final name = TextEditingController();
    final email = TextEditingController();
    final roles = <StaffRole>{};
    String? duplicateError;
    String? formError;
    String? roleError;
    String? emailHint;
    bool checking = false;
    bool busy = false;
    Timer? debounce;
    int sequence = 0;

    try {
      await showDialog<void>(
        context: context,
        barrierDismissible: false,
        builder: (dialogContext) => StatefulBuilder(
          builder: (ctx, update) {
            Future<void> checkEmail() async {
              final address = email.text.trim().toLowerCase();
              if (StaffFormValidation.email(address) != null) return;
              final ticket = ++sequence;
              final known = StaffEmailCheck.findDuplicate(
                address, _lastDirectory.map((s) => s.email),
              );
              if (known != null) {
                if (dialogContext.mounted) {
                  update(() { duplicateError = known; emailHint = null; checking = false; });
                  form.currentState?.validate();
                }
                return;
              }
              if (dialogContext.mounted) update(() { checking = true; emailHint = null; });
              try {
                final existing = await widget.repository.db
                    .collection('staffProfiles')
                    .where('email', isEqualTo: address)
                    .limit(1).get();
                if (!dialogContext.mounted || ticket != sequence ||
                    address != email.text.trim().toLowerCase()) return;
                update(() {
                  duplicateError = existing.docs.isEmpty ? null
                      : 'This email is already in use.';
                  checking = false;
                });
                form.currentState?.validate();
              } catch (_) {
                if (dialogContext.mounted && ticket == sequence) {
                  update(() {
                    checking = false;
                    emailHint = 'Couldn\'t check this email yet.';
                  });
                }
              }
            }

            return StaffDialogFrame(
              title: 'Create Staff Account',
              subtitle: 'Use an email address this employee can receive.',
              onClose: busy ? null : () => Navigator.pop(dialogContext),
              child: Form(
                key: form,
                autovalidateMode: AutovalidateMode.onUserInteraction,
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    const StaffFieldLabel('Full name *'),
                    TextFormField(
                      key: const Key('staff-create-name'),
                      controller: name, enabled: !busy,
                      textCapitalization: TextCapitalization.words,
                      decoration: const InputDecoration(
                        hintText: 'e.g. Loo Chee Beng',
                        prefixIcon: Icon(Icons.person_outline, size: 20)),
                      validator: StaffFormValidation.fullName,
                    ),
                    const SizedBox(height: 18),
                    const StaffFieldLabel('Employee email *'),
                    Focus(
                      onFocusChange: (focused) {
                        if (!focused && !busy) unawaited(checkEmail());
                      },
                      child: TextFormField(
                        key: const Key('staff-create-email'),
                        controller: email, enabled: !busy,
                        keyboardType: TextInputType.emailAddress,
                        autocorrect: false,
                        autofillHints: const [AutofillHints.email],
                        decoration: InputDecoration(
                          hintText: 'e.g. staff@gmail.com',
                          prefixIcon: const Icon(Icons.alternate_email, size: 20),
                          suffixIcon: checking ? const Padding(
                            padding: EdgeInsets.all(12),
                            child: SizedBox(width: 17, height: 17,
                              child: CircularProgressIndicator(strokeWidth: 2)),
                          ) : null,
                        ),
                        validator: (value) =>
                            StaffFormValidation.email(value) ?? duplicateError,
                        onChanged: (value) {
                          sequence++;
                          debounce?.cancel();
                          if (duplicateError != null || emailHint != null) {
                            update(() { duplicateError = null; emailHint = null; checking = false; });
                          }
                          if (StaffFormValidation.email(value) == null) {
                            debounce = Timer(const Duration(milliseconds: 550),
                                () => unawaited(checkEmail()));
                          }
                        },
                        onFieldSubmitted: (_) => unawaited(checkEmail()),
                      ),
                    ),
                    const SizedBox(height: 7),
                    if (emailHint != null) Padding(
                      padding: const EdgeInsets.only(bottom: 6),
                      child: Text(emailHint!, style: const TextStyle(
                        fontSize: 12, color: Color(0xFF8E621E))),
                    ),
                    const Text(
                      'Password setup instructions will be sent here. '
                      'Email availability is checked when you create the account.',
                      style: TextStyle(fontSize: 12, color: adminMuted),
                    ),
                    const SizedBox(height: 20),
                    const Divider(height: 1, color: adminBorder),
                    const SizedBox(height: 18),
                    const StaffFieldLabel('Eligible roles *'),
                    _StaffRolePicker(
                      roles: roles, enabled: !busy,
                      onToggle: (role, chosen) => update(() {
                        if (chosen) { roles.add(role); } else { roles.remove(role); }
                        roleError = null;
                      }),
                    ),
                    if (roleError != null) _InlineError(roleError!),
                    const SizedBox(height: 18),
                    const Text('New staff start Inactive. Email verification '
                        'and approval are required to activate.',
                        style: TextStyle(fontSize: 12, color: adminMuted)),
                    if (formError != null) _InlineError(formError!),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: busy ? null : () => Navigator.pop(dialogContext),
                  child: const Text('Cancel'),
                ),
                AdminButton(busy ? 'Creating…' : 'Create Staff',
                  icon: Icons.person_add_alt_1,
                  onPressed: busy ? null : () async {
                    final valid = form.currentState?.validate() ?? false;
                    if (roles.isEmpty) update(() => roleError = 'Select at least one role.');
                    if (!valid || roles.isEmpty) return;
                    update(() { busy = true; formError = null; });
                    try {
                      // Recheck directory immediately before creating Auth user.
                      await checkEmail();
                      if (duplicateError != null) return;
                      final created = await _onboarding.createStaff(
                        fullName: name.text.trim(),
                        email: email.text.trim().toLowerCase(),
                        eligibleRoles: roles,
                      );
                      if (mounted) setState(() { selectedUid = created.uid; });
                      try {
                        await _onboarding.sendPasswordSetupEmail(created.email);
                        _notify('Staff account created. Check the email inbox.');
                      } catch (mailError) {
                        _notify('Account created. Couldn\'t send the email. Select Resend Setup Email.', failure: true);
                      }
                      if (dialogContext.mounted) Navigator.pop(dialogContext);
                    } catch (e) {
                      if (dialogContext.mounted) {
                        update(() {
                          if (e.toString().contains('email-already-in-use')) {
                            duplicateError = _message(e);
                            form.currentState?.validate();
                          } else {
                            formError = _message(e);
                          }
                        });
                      }
                    } finally {
                      if (dialogContext.mounted) update(() => busy = false);
                    }
                  },
                ),
              ],
            );
          },
        ),
      );
    } finally {
      debounce?.cancel();
      name.dispose();
      email.dispose();
    }
  }

  Future<void> _resendSetupEmail(StaffProfile staff) async {
    try {
      await _onboarding.sendPasswordSetupEmail(staff.email);
      _notify('Password setup email requested for ${staff.email}.');
    } catch (e) {
      _notify(_message(e), failure: true);
    }
  }

  Future<bool> _confirm({
    required String title,
    required String details,
    required String confirmLabel,
  }) async {
    return await showDialog<bool>(
      context: context,
      builder: (ctx) => StaffDialogFrame(
        maxHeight: 340,
        title: title,
        subtitle: 'Please confirm this staff management action.',
        child: Text(details, style: const TextStyle(fontSize: 14, height: 1.5)),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('Cancel')),
          AdminButton(confirmLabel,
            onPressed: () => Navigator.pop(ctx, true)),
        ],
      ),
    ) ?? false;
  }

  bool _verified(StaffProfile person, Map<String, String> proofs) =>
      proofs[person.uid] == person.email.trim().toLowerCase();

  Future<void> _changeStatus(StaffProfile person, String next) async {
    if (next == person.status || statusBusyUid != null) return;
    if (next == 'active') {
      try {
        // Never trust the UI's cached verification badge alone.
        final proof = await widget.repository.db.collection('staffEmailVerifications')
            .doc(person.uid).get();
        if (!proof.exists || proof.data()?['email'] != person.email.trim().toLowerCase()) {
          _notify('Verify the email before activation.', failure: true);
          return;
        }
      } catch (e) {
        _notify('Couldn\'t check email verification. Try again.', failure: true);
        return;
      }
    }
    if (!mounted) return;
    final action = next == 'active' ? 'Activate' : next == 'suspended' ? 'Suspend' : 'Mark Inactive';
    final okay = await _confirm(
      title: '$action ${person.fullName}?',
      details: next == 'active'
          ? 'Their email is verified. This enables read-only Staff Portal access. Ride, photo and admission tools still require separate authorized shifts and training.'
          : 'Staff access will be blocked. Records will be kept.',
      confirmLabel: action,
    );
    if (!okay || !mounted) return;
    setState(() => statusBusyUid = person.uid);
    try {
      await widget.repository.saveStaffProfile(
        uid: person.uid, fullName: person.fullName, email: person.email,
        status: next, eligibleRoles: person.eligibleRoles,
      );
      _notify('${person.fullName} is now ${next.toUpperCase()}.');
    } catch (e) {
      _notify(_message(e), failure: true);
    } finally {
      if (mounted) setState(() => statusBusyUid = null);
    }
  }

  Widget _statusButton(StaffProfile person, bool verified) {
    if (statusBusyUid == person.uid) {
      return const SizedBox(width: 22, height: 22,
          child: CircularProgressIndicator(strokeWidth: 2));
    }
    final tone = person.status == 'active' ? const Color(0xFF27734F)
        : person.status == 'suspended' ? const Color(0xFFB42318)
        : const Color(0xFF926321);
    return PopupMenuButton<String>(
      tooltip: verified ? 'Change employee status' : 'Verify email before activation',
      onSelected: (value) => _changeStatus(person, value),
      itemBuilder: (_) => [
        for (final status in const ['active', 'inactive', 'suspended'])
          PopupMenuItem<String>(
            value: status,
            enabled: status != person.status && (status != 'active' || verified),
            child: Row(children: [
              Icon(status == 'active' ? Icons.check_circle_outline
                  : status == 'suspended' ? Icons.block
                  : Icons.pause_circle_outline, size: 17),
              const SizedBox(width: 10),
              Text(status == 'active' ? 'Active'
                  : status == 'suspended' ? 'Suspended' : 'Inactive'),
            ]),
          ),
      ],
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 9),
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(7),
          color: tone.withValues(alpha: 0.08),
          border: Border.all(color: tone.withValues(alpha: 0.26)),
        ),
        child: Row(mainAxisSize: MainAxisSize.min, children: [
          Text(person.status == 'active' ? 'Active'
              : person.status == 'suspended' ? 'Suspended' : 'Inactive',
              style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600, color: tone)),
          const SizedBox(width: 4),
          Icon(Icons.arrow_drop_down, size: 18, color: tone),
        ]),
      ),
    );
  }

  Future<void> _editStaff(StaffProfile person) async {
    final form = GlobalKey<FormState>();
    final name = TextEditingController(text: person.fullName);
    final roles = <StaffRole>{...person.eligibleRoles};
    String? formError;
    bool saving = false;
    try {
      await showDialog<void>(
        context: context,
        barrierDismissible: false,
        builder: (ctx) => StatefulBuilder(builder: (ctx, update) => StaffDialogFrame(
          title: 'Edit Staff Details & Roles',
          subtitle: '${person.staffId} · ${person.email}',
          onClose: saving ? null : () => Navigator.pop(ctx),
          child: Form(
            key: form,
            autovalidateMode: AutovalidateMode.onUserInteraction,
            child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
              const StaffFieldLabel('Full name *'),
              TextFormField(
                controller: name, enabled: !saving,
                validator: StaffFormValidation.fullName,
                decoration: const InputDecoration(prefixIcon: Icon(Icons.person_outline)),
              ),
              const SizedBox(height: 12),
              const Text('Email cannot be changed here.',
                  style: TextStyle(fontSize: 12, color: adminMuted)),
              const SizedBox(height: 20),
              const StaffFieldLabel('Eligible roles'),
              _StaffRolePicker(
                roles: roles, enabled: !saving,
                onToggle: (role, chosen) => update(() {
                  if (chosen) { roles.add(role); } else { roles.remove(role); }
                }),
              ),
              const SizedBox(height: 14),
              const Text('Account status is managed independently using the Status button in the staff row.',
                  style: TextStyle(fontSize: 12, color: adminMuted)),
              if (formError != null) _InlineError(formError!),
            ]),
          ),
          actions: [
            TextButton(onPressed: saving ? null : () => Navigator.pop(ctx),
                child: const Text('Cancel')),
            AdminButton(saving ? 'Saving…' : 'Save Changes',
              onPressed: saving ? null : () async {
                if (!(form.currentState?.validate() ?? false)) return;
                update(() { saving = true; formError = null; });
                try {
                  await widget.repository.saveStaffProfile(
                    uid: person.uid, fullName: name.text.trim(),
                    email: person.email, status: person.status,
                    eligibleRoles: roles,
                  );
                  if (ctx.mounted) Navigator.pop(ctx);
                  _notify('Staff details updated.');
                } catch (e) {
                  if (ctx.mounted) update(() => formError = _message(e));
                } finally {
                  if (ctx.mounted) update(() => saving = false);
                }
              },
            ),
          ],
        )),
      );
    } finally {
      name.dispose();
    }
  }

  Future<void> _createCourse() async {
    final form = GlobalKey<FormState>();
    final title = TextEditingController();
    var role = StaffRole.photographer;
    String? formError;
    var busy = false;
    try {
      await showDialog<void>(
        context: context,
        barrierDismissible: false,
        builder: (ctx) => StatefulBuilder(builder: (ctx, update) => StaffDialogFrame(
          title: 'Add Training Course',
          subtitle: 'Create once; supervisors will select it when recording training.',
          onClose: busy ? null : () => Navigator.pop(ctx),
          child: Form(
            key: form, autovalidateMode: AutovalidateMode.onUserInteraction,
            child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
              const StaffFieldLabel('Course name *'),
              TextFormField(
                controller: title, enabled: !busy,
                decoration: const InputDecoration(
                    hintText: 'e.g. Guest Photography & Privacy'),
                validator: (value) {
                  final text = (value ?? '').trim();
                  return text.length < 4 || text.length > 120
                      ? 'Enter a clear course name (4–120 characters).'
                      : null;
                },
              ),
              const SizedBox(height: 18),
              const StaffFieldLabel('Required job role *'),
              DropdownButtonFormField<StaffRole>(
                initialValue: role,
                isExpanded: true,
                items: StaffRole.values.where((r) => r != StaffRole.superAdmin)
                    .map((r) => DropdownMenuItem(value: r, child: Text(r.label))).toList(),
                onChanged: busy ? null : (v) => update(() => role = v ?? role),
              ),
              const SizedBox(height: 14),
              const Text('For ride operators, the exact attraction is selected later when the course is recorded for an employee.',
                  style: TextStyle(fontSize: 12, color: adminMuted)),
              if (formError != null) _InlineError(formError!),
            ]),
          ),
          actions: [
            TextButton(onPressed: busy ? null : () => Navigator.pop(ctx),
                child: const Text('Cancel')),
            AdminButton(busy ? 'Saving…' : 'Add Course',
              onPressed: busy ? null : () async {
                if (!(form.currentState?.validate() ?? false)) return;
                update(() { busy = true; formError = null; });
                try {
                  await _catalog.createCourse(title: title.text, role: role);
                  if (ctx.mounted) Navigator.pop(ctx);
                  _notify('Course added.');
                } catch (e) {
                  if (ctx.mounted) update(() => formError = _message(e));
                } finally {
                  if (ctx.mounted) update(() => busy = false);
                }
              },
            ),
          ],
        )),
      );
    } finally {
      title.dispose();
    }
  }

  Future<void> _manageCourses() async {
    await showDialog<void>(
      context: context,
      builder: (ctx) => StaffDialogFrame(
        title: 'Training Course Catalogue',
        subtitle: 'Standardized courses shared across all staff records.',
        maxWidth: 720,
        maxHeight: 690,
        onClose: () => Navigator.pop(ctx),
        child: StreamBuilder<List<StaffTrainingCourse>>(
          stream: _catalog.watchCourses(),
          builder: (context, snapshot) {
            if (snapshot.hasError) return _InlineError(_message(snapshot.error!));
            if (!snapshot.hasData) return const LinearProgressIndicator();
            final courses = snapshot.data!;
            if (courses.isEmpty) return const Padding(
              padding: EdgeInsets.symmetric(vertical: 20),
              child: Text('No courses yet. Add one to get started.'),
            );
            return Column(children: [
              for (final course in courses) Padding(
                padding: const EdgeInsets.symmetric(vertical: 7),
                child: Row(children: [
                  Expanded(child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(course.title, style: const TextStyle(
                          fontWeight: FontWeight.w600)),
                      const SizedBox(height: 3),
                      Text(course.role.label, style: const TextStyle(
                          fontSize: 12, color: adminMuted)),
                    ],
                  )),
                  const SizedBox(width: 12),
                  Text(course.active ? 'Available' : 'Archived',
                    style: TextStyle(fontSize: 12,
                      color: course.active ? const Color(0xFF27734F) : adminMuted)),
                  const SizedBox(width: 8),
                  TextButton(
                    onPressed: () async {
                      final okay = await _confirm(
                        title: course.active ? 'Archive course?' : 'Restore course?',
                        details: 'Existing training history will be retained.',
                        confirmLabel: course.active ? 'Archive' : 'Restore',
                      );
                      if (!okay) return;
                      try {
                        await _catalog.setActive(course, !course.active);
                        _notify('Course updated.');
                      } catch (e) {
                        _notify(_message(e), failure: true);
                      }
                    },
                    child: Text(course.active ? 'Archive' : 'Restore'),
                  ),
                ]),
              ),
            ]);
          },
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Close')),
          AdminButton('Add Course', icon: Icons.add,
            onPressed: _createCourse),
        ],
      ),
    );
  }

  Future<void> _addTraining(StaffProfile person) async {
    if (person.eligibleRoles.isEmpty) {
      _notify('Assign a role before recording training.', failure: true);
      return;
    }
    List<StaffTrainingCourse> courses;
    try {
      courses = await _catalog.activeCourses();
    } catch (_) {
      _notify('Couldn\'t load courses. Try again.', failure: true);
      return;
    }
    final applicable = courses.where((course) =>
        person.eligibleRoles.contains(course.role)).toList();
    if (applicable.isEmpty) {
      _notify('No courses available for this staff member.', failure: true);
      return;
    }

    // A course has its own ride and expiry; only completion date is shared.
    final picked = <String>{};
    final rideByCourse = <String, String>{};
    final expiryByCourse = <String, DateTime>{};
    final ridesFuture = widget.repository.db.collection('attractions').get();
    final completed = ValueNotifier<DateTime>(DateUtils.dateOnly(DateTime.now()));
    String? formError;
    bool busy = false;

    try {
      await showDialog<void>(
        context: context,
        barrierDismissible: false,
        builder: (dialogContext) => StatefulBuilder(
          builder: (ctx, update) {
            final chosen = applicable.where((c) => picked.contains(c.id)).toList();
            return StaffDialogFrame(
              title: 'Record Training',
              subtitle: '${person.fullName} · ${person.staffId}',
              maxWidth: 720,
              maxHeight: 760,
              onClose: busy ? null : () => Navigator.pop(dialogContext),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  const Text('Select completed courses only.',
                      style: TextStyle(color: adminMuted, fontSize: 13)),
                  const SizedBox(height: 16),
                  const StaffFieldLabel('Completed courses *'),
                  Container(
                    decoration: BoxDecoration(
                      color: Colors.white,
                      border: Border.all(color: adminBorder),
                      borderRadius: BorderRadius.circular(9),
                    ),
                    child: Column(children: [
                      for (final course in applicable) ...[
                        if (course.id != applicable.first.id)
                          const Divider(height: 1, color: adminBorder),
                        CheckboxListTile(
                          key: Key('staff-training-course-${course.id}'),
                          value: picked.contains(course.id),
                          enabled: !busy,
                          controlAffinity: ListTileControlAffinity.leading,
                          dense: true,
                          activeColor: adminRose,
                          title: Text(course.title, style: const TextStyle(
                            fontSize: 13, fontWeight: FontWeight.w600)),
                          subtitle: Text(course.role.label,
                            style: const TextStyle(fontSize: 12, color: adminMuted)),
                          onChanged: busy ? null : (yes) => update(() {
                            if (yes == true) {
                              if (picked.length >= 3) {
                                formError = 'Select up to 3 courses at a time.';
                                return;
                              }
                              picked.add(course.id);
                            }
                            else { picked.remove(course.id); }
                            formError = null;
                          }),
                        ),
                      ],
                    ]),
                  ),
                  const SizedBox(height: 10),
                  Text('${picked.length} course(s) selected',
                    style: const TextStyle(fontSize: 12, color: adminMuted)),
                  if (formError == 'Select at least one course.' ||
                      formError == 'Select up to 3 courses at a time.')
                    _InlineError(formError!),
                  const SizedBox(height: 20),
                  const StaffFieldLabel('Completion date *'),
                  OutlinedButton.icon(
                    icon: const Icon(Icons.event_outlined, size: 18),
                    label: Text(_date(completed.value)),
                    onPressed: busy ? null : () async {
                      final date = await showDatePicker(
                        context: dialogContext,
                        initialDate: completed.value,
                        firstDate: DateTime(2000),
                        lastDate: DateUtils.dateOnly(DateTime.now()),
                      );
                      if (date != null) update(() {
                        completed.value = date;
                        expiryByCourse.removeWhere((_, expiry) =>
                            !expiry.isAfter(date));
                      });
                    },
                  ),
                  if (chosen.isNotEmpty) ...[
                    const SizedBox(height: 20),
                    const StaffFieldLabel('Course details'),
                    const Text('Review dates can be set for each course.',
                      style: TextStyle(fontSize: 12, color: adminMuted)),
                    if (chosen.any((c) => c.role == StaffRole.attractionOperator)) ...[
                      const SizedBox(height: 8),
                      Align(alignment: Alignment.centerLeft,
                        child: TextButton.icon(
                          icon: const Icon(Icons.event_repeat_outlined, size: 18),
                          label: const Text('Set the same ride review date'),
                          onPressed: busy ? null : () async {
                            final start = completed.value.add(const Duration(days: 1));
                            final date = await showDatePicker(
                              context: dialogContext,
                              initialDate: completed.value.add(const Duration(days: 365)),
                              firstDate: start,
                              lastDate: DateTime(2100),
                            );
                            if (date != null) update(() {
                              for (final c in chosen.where((c) =>
                                  c.role == StaffRole.attractionOperator)) {
                                expiryByCourse[c.id] = date;
                              }
                            });
                          },
                        ),
                      ),
                    ],
                    const SizedBox(height: 10),
                    for (final course in chosen) Container(
                      key: Key('staff-training-details-${course.id}'),
                      margin: const EdgeInsets.only(bottom: 12),
                      padding: const EdgeInsets.all(14),
                      decoration: BoxDecoration(
                        color: Colors.white,
                        border: Border.all(color: adminBorder),
                        borderRadius: BorderRadius.circular(9),
                      ),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          Text(course.title, style: const TextStyle(
                              fontSize: 14, fontWeight: FontWeight.w600,
                              color: adminDark)),
                          if (course.role == StaffRole.attractionOperator) ...[
                            const SizedBox(height: 12),
                            const StaffFieldLabel('Qualified attraction *'),
                            FutureBuilder<QuerySnapshot<Map<String, dynamic>>>(
                              future: ridesFuture,
                              builder: (context, snapshot) {
                                if (snapshot.hasError) {
                                  return const _InlineError('Couldn\'t load rides. Try again.');
                                }
                                if (!snapshot.hasData) {
                                  return const LinearProgressIndicator(color: adminRose);
                                }
                                // A ride training title must name the exact ride.
                                // Never let a Bumper Cars course qualify a Ferris Wheel.
                                final validRides = snapshot.data!.docs.where((r) {
                                  final data = r.data();
                                  final name = (data['name']?.toString() ?? '').trim();
                                  return data['deletedAt'] == null &&
                                      name.isNotEmpty &&
                                      course.title.toLowerCase().contains(name.toLowerCase());
                                }).toList();
                                if (validRides.isEmpty) {
                                  return const _InlineError(
                                    'Course name must match a park ride.');
                                }
                                return DropdownButtonFormField<String>(
                                  key: ValueKey('ride-${course.id}'),
                                  initialValue: validRides.any((r) =>
                                          r.id == rideByCourse[course.id])
                                      ? rideByCourse[course.id] : null,
                                  hint: const Text('Select ride'),
                                  isExpanded: true,
                                  items: validRides.map((ride) => DropdownMenuItem(
                                    value: ride.id,
                                    child: Text(ride.data()['name']?.toString() ?? ride.id),
                                  )).toList(),
                                  onChanged: busy ? null : (id) => update(() {
                                    if (id != null) rideByCourse[course.id] = id;
                                  }),
                                );
                              },
                            ),
                          ],
                          const SizedBox(height: 12),
                          StaffFieldLabel(course.role == StaffRole.attractionOperator
                              ? 'Review / expiry date *' : 'Expiry date (optional)'),
                          Row(children: [
                            Expanded(child: OutlinedButton.icon(
                              icon: const Icon(Icons.event_available_outlined, size: 17),
                              label: Text(expiryByCourse[course.id] == null
                                  ? 'Choose date' : _date(expiryByCourse[course.id]!)),
                              onPressed: busy ? null : () async {
                                final date = await showDatePicker(
                                  context: dialogContext,
                                  initialDate: expiryByCourse[course.id] ??
                                      completed.value.add(const Duration(days: 365)),
                                  firstDate: completed.value.add(const Duration(days: 1)),
                                  lastDate: DateTime(2100),
                                );
                                if (date != null) update(() => expiryByCourse[course.id] = date);
                              },
                            )),
                            if (expiryByCourse.containsKey(course.id) &&
                                course.role != StaffRole.attractionOperator) ...[
                              const SizedBox(width: 8),
                              IconButton(
                                tooltip: 'Remove expiry date',
                                onPressed: busy ? null : () => update(() =>
                                    expiryByCourse.remove(course.id)),
                                icon: const Icon(Icons.close, size: 18),
                              ),
                            ],
                          ]),
                        ],
                      ),
                    ),
                  ],
                  if (formError != null &&
                      formError != 'Select at least one course.' &&
                      formError != 'Select up to 3 courses at a time.')
                    _InlineError(formError!),
                ],
              ),
              actions: [
                TextButton(
                  onPressed: busy ? null : () => Navigator.pop(dialogContext),
                  child: const Text('Cancel'),
                ),
                AdminButton(busy ? 'Saving…' : 'Approve Training',
                  icon: Icons.verified_outlined,
                  onPressed: busy ? null : () async {
                    if (chosen.isEmpty) {
                      update(() => formError = 'Select at least one course.');
                      return;
                    }
                    if (chosen.any((c) => c.role == StaffRole.attractionOperator &&
                        !rideByCourse.containsKey(c.id))) {
                      update(() => formError = 'Select a ride for each ride course.');
                      return;
                    }
                    if (chosen.any((c) => c.role == StaffRole.attractionOperator &&
                        !expiryByCourse.containsKey(c.id))) {
                      update(() => formError = 'Set a review date for each ride course.');
                      return;
                    }
                    update(() { busy = true; formError = null; });
                    try {
                      final existing = await widget.repository
                          .watchQualifications(person.uid).first;
                      for (final course in chosen) {
                        if (existing.any((r) =>
                            r.title == course.title && r.role == course.role &&
                            r.attractionId == rideByCourse[course.id] &&
                            r.validAt(DateTime.now()))) {
                          throw ArgumentError('This training is already recorded.');
                        }
                      }
                      await widget.repository.saveQualificationsBatch(
                        staffUid: person.uid,
                        completedAt: completed.value,
                        courses: [
                          for (final course in chosen) StaffTrainingEntry(
                            courseId: course.id,
                            title: course.title,
                            role: course.role,
                            attractionId: rideByCourse[course.id],
                            // The date shown to the user is inclusive; stored expiry is exclusive.
                            expiresAt: expiryByCourse[course.id] == null ? null
                                : expiryByCourse[course.id]!
                                    .add(const Duration(days: 1))
                                    .subtract(const Duration(milliseconds: 1)),
                          ),
                        ],
                      );
                      if (dialogContext.mounted) Navigator.pop(dialogContext);
                      _notify('Training recorded for ${chosen.length} course(s).');
                    } catch (e) {
                      if (dialogContext.mounted) update(() => formError = _message(e));
                    } finally {
                      if (dialogContext.mounted) update(() => busy = false);
                    }
                  },
                ),
              ],
            );
          },
        ),
      );
    } finally {
      completed.dispose();
    }
  }

  String _date(DateTime date) => '${date.year}-'
      '${date.month.toString().padLeft(2, '0')}-'
      '${date.day.toString().padLeft(2, '0')}';

  Future<void> _revokeTraining(StaffQualification record) async {
    final yes = await _confirm(
      title: 'Revoke training?',
      details: 'This will revoke "${record.title}" while keeping the training history.',
      confirmLabel: 'Revoke Training',
    );
    if (!yes) return;
    try {
      await widget.repository.revokeQualification(record.id);
      _notify('Training revoked.');
    } catch (e) {
      _notify(_message(e), failure: true);
    }
  }

  Widget _qualifications(StaffProfile person) =>
      StreamBuilder<List<StaffQualification>>(
    stream: widget.repository.watchQualifications(person.uid),
    builder: (ctx, snapshot) {
      if (snapshot.hasError) return _InlineError(_message(snapshot.error!));
      if (!snapshot.hasData) return const LinearProgressIndicator();
      if (snapshot.data!.isEmpty) {
        return const Padding(padding: EdgeInsets.symmetric(vertical: 16),
            child: Text('No verified training records yet.',
                style: TextStyle(color: adminMuted)));
      }
      return Column(children: [
        for (final record in snapshot.data!) ListTile(
          contentPadding: EdgeInsets.zero,
          leading: Icon(record.validAt(DateTime.now())
              ? Icons.verified_outlined : Icons.warning_amber_outlined,
              color: record.validAt(DateTime.now())
                  ? const Color(0xFF27734F) : const Color(0xFFC17A23)),
          title: Text(record.title, style: const TextStyle(
              fontWeight: FontWeight.w600, fontSize: 14)),
          subtitle: Text('${record.role.label}'
              '${record.attractionId == null ? '' : ' · Ride ID: ${record.attractionId}'}'
              ' · ${record.status == 'revoked' ? 'Revoked' : record.validAt(DateTime.now()) ? 'Valid' : 'Expired'}'
              '${record.expiresAt == null ? '' : ' · Review by ${_date(record.expiresAt!.toLocal())}'}'),
          trailing: record.status == 'approved' ? TextButton(
            onPressed: () => _revokeTraining(record),
            child: const Text('Revoke'),
          ) : null,
        ),
      ]);
    },
  );

  Widget _banner(String message, {bool failure = false}) => Padding(
    padding: const EdgeInsets.only(bottom: 14),
    child: Container(
      padding: const EdgeInsets.all(15),
      decoration: BoxDecoration(
        color: failure ? const Color(0xFFFFE8E5) : const Color(0xFFEAF6EE),
        borderRadius: BorderRadius.circular(9),
        border: Border.all(color: failure
            ? const Color(0xFFC55249) : const Color(0xFF91C9A5)),
      ),
      child: Row(children: [
        Icon(failure ? Icons.error_outline : Icons.check_circle_outline,
            color: failure ? const Color(0xFFA52C22) : const Color(0xFF27734F)),
        const SizedBox(width: 12),
        Expanded(child: Text(message, style: TextStyle(
          fontSize: 13, fontWeight: FontWeight.w600,
          color: failure ? const Color(0xFF92261F) : const Color(0xFF216D45),
        ))),
        IconButton(
          tooltip: 'Dismiss message',
          onPressed: () => setState(() {
            if (failure) { error = null; } else { notice = null; }
          }),
          icon: const Icon(Icons.close, size: 18),
        ),
      ]),
    ),
  );

  Widget _verificationBadge(bool verified) => Container(
    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
    decoration: BoxDecoration(
      borderRadius: BorderRadius.circular(6),
      color: verified ? const Color(0xFFEAF5EF) : const Color(0xFFFFF2DD),
    ),
    child: Row(mainAxisSize: MainAxisSize.min, children: [
      Icon(verified ? Icons.verified_outlined : Icons.schedule_outlined,
          size: 15, color: verified ? const Color(0xFF27734F) : const Color(0xFF9B651D)),
      const SizedBox(width: 5),
      Text(verified ? 'Verified' : 'Pending', style: TextStyle(
        fontSize: 12, color: verified ? const Color(0xFF27734F) : const Color(0xFF9B651D),
      )),
    ]),
  );

  Widget _directory(List<StaffProfile> people, Map<String, String> proofs) =>
      AdminCard(
    padding: EdgeInsets.zero,
    child: LayoutBuilder(builder: (context, constraints) =>
        SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      child: ConstrainedBox(
        constraints: BoxConstraints(minWidth: constraints.maxWidth),
        child: DataTable(
          showCheckboxColumn: false,
          dataRowColor: WidgetStateProperty.resolveWith<Color?>((states) =>
              states.contains(WidgetState.selected)
                  ? const Color(0xFFFFF3F1) : Colors.white),
          headingRowColor: const WidgetStatePropertyAll(Color(0xFFF9F0EE)),
          headingTextStyle: const TextStyle(fontSize: 12,
              fontWeight: FontWeight.w700, color: adminDark),
          dataRowMinHeight: 62,
          dataRowMaxHeight: 72,
          horizontalMargin: 18,
          columnSpacing: 21,
          columns: const [
            DataColumn(label: Text('Employee')),
            DataColumn(label: Text('Staff ID')),
            DataColumn(label: Text('Eligible Roles')),
            DataColumn(label: Text('Email Verification')),
            DataColumn(label: Text('Status')),
            DataColumn(label: Text('Actions')),
          ],
          rows: [
            for (final person in people) DataRow(
              selected: person.uid == selectedUid,
              onSelectChanged: (_) => setState(() => selectedUid = person.uid),
              cells: [
                DataCell(SizedBox(width: 205,
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(person.fullName,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(color: adminDark,
                            fontSize: 13, fontWeight: FontWeight.w600)),
                      const SizedBox(height: 4),
                      Text(person.email,
                          overflow: TextOverflow.ellipsis,
                          style: const TextStyle(fontSize: 11, color: adminMuted)),
                    ],
                  ),
                )),
                DataCell(Text(person.staffId.isEmpty ? '—' : person.staffId)),
                DataCell(SizedBox(width: 155,
                    child: Text(person.eligibleRoles.map((r) => r.label).join(', '),
                        maxLines: 2, overflow: TextOverflow.ellipsis,
                        style: const TextStyle(fontSize: 12)))),
                DataCell(_verificationBadge(_verified(person, proofs))),
                DataCell(_statusButton(person, _verified(person, proofs))),
                DataCell(TextButton.icon(
                  onPressed: () => setState(() => selectedUid = person.uid),
                  icon: const Icon(Icons.open_in_new, size: 15),
                  label: const Text('Details'),
                )),
              ],
            ),
          ],
        ),
      ),
    )),
  );

  Widget _details(StaffProfile person, bool verified) => AdminCard(
    child: Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        Row(children: [
          Expanded(child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text('EMPLOYEE DETAILS', style: TextStyle(
                  color: adminMuted, fontSize: 11, fontWeight: FontWeight.w700)),
              const SizedBox(height: 8),
              Text(person.fullName, style: const TextStyle(
                  color: adminDark, fontSize: 21, fontWeight: FontWeight.w700)),
              const SizedBox(height: 4),
              Text('${person.staffId} · ${person.email}',
                style: const TextStyle(fontSize: 13, color: adminMuted)),
            ],
          )),
          IconButton(
            tooltip: 'Close employee details',
            onPressed: () => setState(() => selectedUid = null),
            icon: const Icon(Icons.close, color: adminMuted),
          ),
        ]),
        const SizedBox(height: 14),
        Wrap(spacing: 7, runSpacing: 7, children: [
          _verificationBadge(verified),
          for (final role in person.eligibleRoles) Chip(
            side: const BorderSide(color: adminBorder),
            backgroundColor: const Color(0xFFFCF6F4),
            label: Text(role.label, style: const TextStyle(fontSize: 12)),
          ),
        ]),
        if (!verified) Padding(
          padding: const EdgeInsets.only(top: 10),
          child: const Text('Verify the email before activation.',
            style: TextStyle(color: Color(0xFF9B651D),
                fontSize: 12, fontWeight: FontWeight.w600)),
        ),
        if (!verified && person.status == 'active') Padding(
          padding: const EdgeInsets.only(top: 10),
          child: const _InlineError('Email not verified. Set status to Inactive.'),
        ),
        const SizedBox(height: 18),
        Wrap(spacing: 9, runSpacing: 9, children: [
          AdminButton('Edit Details / Roles', outlined: true,
            icon: Icons.edit_outlined, onPressed: () => _editStaff(person)),
          AdminButton('Record Training', outlined: true,
            icon: Icons.school_outlined, onPressed: () => _addTraining(person)),
          AdminButton('Resend Setup Email', outlined: true,
            icon: Icons.mark_email_unread_outlined,
            onPressed: () => _resendSetupEmail(person)),
        ]),
        const Divider(height: 34, color: adminBorder),
        const Text('Training Qualifications', style: TextStyle(
            color: adminDark, fontSize: 16, fontWeight: FontWeight.w700)),
        const SizedBox(height: 4),
        _qualifications(person),
        const SizedBox(height: 12),
        SelectableText('Account ID: ${person.uid}', style: const TextStyle(
            fontSize: 11, color: adminMuted)),
      ],
    ),
  );

  @override
  Widget build(BuildContext context) => StreamBuilder<List<StaffProfile>>(
    stream: _staffStream,
    builder: (ctx, snapshot) => StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
      stream: _proofStream,
      builder: (ctx, proofSnapshot) {
        final everyone = snapshot.data ?? <StaffProfile>[];
        _lastDirectory = everyone;
        final proofs = <String, String>{};
        if (proofSnapshot.hasData) {
          for (final doc in proofSnapshot.data!.docs) {
            final email = doc.data()['email'];
            if (email is String) proofs[doc.id] = email.trim().toLowerCase();
          }
        }
        final filter = search.trim().toLowerCase();
        final people = everyone.where((p) {
          final matchSearch = filter.isEmpty ||
              '${p.fullName} ${p.email} ${p.staffId}'.toLowerCase().contains(filter);
          return matchSearch && (statusFilter == 'all' || p.status == statusFilter);
        }).toList();
        final selected = everyone.where((p) => p.uid == selectedUid).firstOrNull;
        return SingleChildScrollView(
          padding: const EdgeInsets.all(8),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              const AdminHeading('Staff Management',
                'Manage employee accounts, roles and verified training records.'),
              const SizedBox(height: 22),
              if (notice != null) _banner(notice!),
              if (error != null) _banner(error!, failure: true),
              if (snapshot.hasError) _banner(_message(snapshot.error!), failure: true),
              if (proofSnapshot.hasError) _banner(
                'Couldn\'t load email verification status.',
                failure: true),
              AdminCard(
                padding: const EdgeInsets.all(16),
                child: Wrap(spacing: 12, runSpacing: 12,
                  crossAxisAlignment: WrapCrossAlignment.center, children: [
                    SizedBox(width: 310, child: TextField(
                      key: const Key('staff-directory-search'),
                      controller: searchController,
                      onChanged: (v) => setState(() => search = v),
                      decoration: const InputDecoration(
                        prefixIcon: Icon(Icons.search, size: 20),
                        hintText: 'Search name, email or Staff ID',
                      ),
                    )),
                    SizedBox(width: 156, child: DropdownButtonFormField<String>(
                      key: ValueKey(statusFilter),
                      initialValue: statusFilter,
                      decoration: const InputDecoration(labelText: 'Status'),
                      items: const [
                        DropdownMenuItem(value: 'all', child: Text('All statuses')),
                        DropdownMenuItem(value: 'active', child: Text('Active')),
                        DropdownMenuItem(value: 'inactive', child: Text('Inactive')),
                        DropdownMenuItem(value: 'suspended', child: Text('Suspended')),
                      ],
                      onChanged: (v) => setState(() => statusFilter = v ?? 'all'),
                    )),
                    AdminButton('Training Catalogue', outlined: true,
                      icon: Icons.menu_book_outlined, onPressed: _manageCourses),
                    AdminButton('Create Staff Account',
                      icon: Icons.person_add_alt_1, onPressed: _createStaff),
                    Text('${everyone.length} staff',
                      style: const TextStyle(fontSize: 13, color: adminMuted)),
                  ],
                ),
              ),
              const SizedBox(height: 16),
              if (snapshot.connectionState == ConnectionState.waiting ||
                  proofSnapshot.connectionState == ConnectionState.waiting)
                const LinearProgressIndicator(),
              if (snapshot.hasData && everyone.isEmpty)
                const AdminCard(child: Padding(
                  padding: EdgeInsets.all(16),
                  child: Text('No staff records. Use Create Staff Account to add an employee.'),
                )),
              if (snapshot.hasData && everyone.isNotEmpty) ...[
                if (people.isEmpty) const AdminCard(
                  child: Text('No employees match these filters.'),
                ) else _directory(people, proofs),
                if (selected != null) ...[
                  const SizedBox(height: 18),
                  _details(selected, _verified(selected, proofs)),
                ],
              ],
              if (proofSnapshot.hasError)
                const Padding(
                  padding: EdgeInsets.only(top: 10),
                  child: Text('Can\'t confirm email verification yet. '
                      'Please try again.',
                      style: TextStyle(fontSize: 12, color: Color(0xFF9B651D))),
                ),
            ],
          ),
        );
      },
    ),
  );
}

class _InlineError extends StatelessWidget {
  const _InlineError(this.value);
  final String value;
  @override
  Widget build(BuildContext context) => Container(
    margin: const EdgeInsets.only(top: 12),
    padding: const EdgeInsets.all(12),
    decoration: BoxDecoration(
      color: const Color(0xFFFFE9E6),
      border: Border.all(color: const Color(0xFFD56A62)),
      borderRadius: BorderRadius.circular(7),
    ),
    child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
      const Icon(Icons.error_outline, size: 19, color: Color(0xFFA52C22)),
      const SizedBox(width: 9),
      Expanded(child: Text(value, style: const TextStyle(
        fontSize: 13, fontWeight: FontWeight.w600,
        color: Color(0xFF9E2B22),
      ))),
    ]),
  );
}

class _StaffRolePicker extends StatelessWidget {
  const _StaffRolePicker({
    required this.roles,
    required this.enabled,
    required this.onToggle,
  });
  final Set<StaffRole> roles;
  final bool enabled;
  final void Function(StaffRole role, bool chosen) onToggle;

  @override
  Widget build(BuildContext context) => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      _group('Park operations', const [StaffRole.operationsManager,
          StaffRole.attractionOperator, StaffRole.admissionStaff]),
      const SizedBox(height: 12),
      _group('Photo & guest services', const [StaffRole.photographer,
          StaffRole.photoCounterStaff, StaffRole.customerSupport]),
      const SizedBox(height: 12),
      _group('Business', const [StaffRole.marketingStaff]),
    ],
  );

  Widget _group(String name, List<StaffRole> options) => Column(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      Text(name, style: const TextStyle(fontSize: 12,
          fontWeight: FontWeight.w600, color: adminMuted)),
      const SizedBox(height: 7),
      Wrap(spacing: 8, runSpacing: 7, children: [
        for (final role in options) FilterChip(
          key: Key('staff-role-${role.code}'),
          selected: roles.contains(role),
          selectedColor: const Color(0xFFF1DADB),
          backgroundColor: Colors.white,
          checkmarkColor: adminRose,
          side: BorderSide(color: roles.contains(role)
              ? adminRose : adminBorder),
          label: Text(role.label, style: TextStyle(
              color: roles.contains(role) ? adminDark : adminMuted,
              fontSize: 12, fontWeight: FontWeight.w500)),
          onSelected: enabled ? (chosen) => onToggle(role, chosen) : null,
        ),
      ]),
    ],
  );
}
