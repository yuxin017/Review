import 'package:firebase_core/firebase_core.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';

import 'data/admin_attraction_store.dart';
import 'data/attraction_training_store.dart';
import 'attraction_map_picker.dart';
import 'attraction_editor_section.dart';
import '../../attractions/models/attraction.dart';
import '../../attractions/widgets/attraction_widgets.dart';
import '../portal/admin_theme.dart';
import 'attraction_admin_guard.dart';
import '../../attractions/widgets/attraction_cover.dart';
import 'cover_photo.dart';
import '../../attractions/data/slot_reader.dart';
import '../../attractions/widgets/attraction_queue_summary.dart';

class AttractionEditorPage extends StatefulWidget {
  const AttractionEditorPage({
    super.key,
    required this.store,
    required this.adminAccess,
    this.attraction,
    this.kind = ParkPlaceKind.attractions,
    this.pickCover,
    this.slotReader,
  });
  final AdminAttractionStore store;
  final ValueListenable<bool> adminAccess;
  final Attraction? attraction;
  final ParkPlaceKind kind;
  final Future<Uint8List?> Function()? pickCover;
  final SlotReader? slotReader;

  @override
  State<AttractionEditorPage> createState() => _AttractionEditorPageState();
}

class _AttractionEditorPageState extends State<AttractionEditorPage> {
  final _form = GlobalKey<FormState>();
  final _name = TextEditingController();
  final _trainingTitle = TextEditingController();
  final _duration = TextEditingController();
  final _riders = TextEditingController();
  final _safetyNotes = TextEditingController();
  final _description = TextEditingController();
  final _standby = TextEditingController();
  final _photoField = GlobalKey<FormFieldState<String>>();
  final _height = TextEditingController();
  final _capacity = TextEditingController();
  final _mapX = TextEditingController();
  final _mapY = TextEditingController();
  late final String _id;
  Attraction? _original;
  String? _category;
  AttractionStatus _status = AttractionStatus.closed;
  bool _saving = false;
  bool _reloading = false;
  String? _error;
  bool _conflict = false;
  String? _cover;
  AttractionCrowd? _crowd;
  bool _pickingPhoto = false;
  ParkPlaceKind get _kind => _original?.placeKind ?? widget.kind;
  bool get _isRide => _kind == ParkPlaceKind.attractions;
  String get _itemName => _kind.itemName;
  static const _categories = [
    'Thrill rides',
    'Family rides',
    'Water rides',
    'Shows',
  ];

  @override
  void initState() {
    super.initState();
    _original = widget.attraction;
    _id = _original?.id ?? widget.store.newAttractionId();
    _fill(_original);
  }

  void _fill(Attraction? attraction) {
    _name.text = attraction?.name ?? '';
    _description.text = attraction?.description ?? '';
    _standby.text = attraction?.standbyMinutes?.toString() ?? '';
    _duration.text = attraction?.rideDurationMinutes?.toString() ?? '';
    _riders.text = attraction?.ridersPerCycle?.toString() ?? '';
    _safetyNotes.text = attraction?.safetyNotes ?? '';
    _cover = attraction?.coverImageBase64;
    _photoField.currentState?.didChange(_cover);
    _crowd = attraction?.crowdLevel;
    _height.text = attraction?.minHeightCm.toString() ?? '0';
    _capacity.text =
        (attraction?.reservationCapacity ??
                Attraction.defaultReservationCapacity)
            .toString();
    _mapX.text = attraction?.mapX.toString() ?? '';
    _mapY.text = attraction?.mapY.toString() ?? '';
    _category = attraction?.category ?? (_isRide ? null : _kind.label);
    _status = attraction?.status ?? AttractionStatus.closed;
  }

  @override
  void dispose() {
    _name.dispose();
    _trainingTitle.dispose();
    _duration.dispose();
    _riders.dispose();
    _safetyNotes.dispose();
    _description.dispose();
    _standby.dispose();
    _height.dispose();
    _capacity.dispose();
    _mapX.dispose();
    _mapY.dispose();
    super.dispose();
  }

  Future<void> _pickPhoto() async {
    if (_saving || _pickingPhoto || !widget.adminAccess.value) return;
    setState(() {
      _pickingPhoto = true;
      _error = null;
    });
    try {
      Uint8List? bytes;
      if (widget.pickCover != null) {
        bytes = await widget.pickCover!();
      } else {
        final photo = await ImagePicker().pickImage(
          source: ImageSource.gallery,
        );
        bytes = await photo?.readAsBytes();
      }
      if (bytes == null) return;
      final encoded = encodeAttractionCover(bytes);
      if (!mounted) return;
      setState(() => _cover = encoded);
      _photoField.currentState?.didChange(encoded);
    } on FormatException catch (error) {
      if (mounted) setState(() => _error = error.message);
    } catch (_) {
      if (mounted) {
        setState(
          () => _error = 'Unable to select this photo. Please choose another.',
        );
      }
    } finally {
      if (mounted) setState(() => _pickingPhoto = false);
    }
  }

  String? _coordinate(String? value) {
    final number = double.tryParse(value?.trim() ?? '');
    return number == null || !number.isFinite
        ? 'Enter a valid number using a decimal point.'
        : null;
  }

  Future<void> _save() async {
    if (_saving ||
        _pickingPhoto ||
        _reloading ||
        !widget.adminAccess.value ||
        !_form.currentState!.validate()) {
      return;
    }
    final replacement = Attraction(
      id: _id,
      name: _name.text,
      category: _category!,
      status: _status,
      minHeightCm: int.parse(_height.text.trim()),
      reservationCapacity: int.parse(_capacity.text.trim()),
      rideDurationMinutes: _isRide && _duration.text.trim().isNotEmpty
          ? int.parse(_duration.text.trim()) : null,
      ridersPerCycle: _isRide && _riders.text.trim().isNotEmpty
          ? int.parse(_riders.text.trim()) : null,
      safetyNotes: _isRide && _safetyNotes.text.trim().isNotEmpty
          ? _safetyNotes.text.trim() : null,
      mapX: double.parse(_mapX.text.trim()),
      mapY: double.parse(_mapY.text.trim()),
      description: _description.text,
      coverImageBase64: _cover,
      crowdLevel: _crowd,
      standbyMinutes: int.tryParse(_standby.text.trim()),
    );
    setState(() {
      _saving = true;
      _error = null;
      _conflict = false;
    });
    try {
      if (_original == null) {
        if (_isRide) {
          final store = widget.store;
          if (store is! AttractionTrainingStore) {
            throw StateError('Training is unavailable.');
          }
          final selectedTitle = _trainingTitle.text.trim();
          final courseTitle = selectedTitle.isEmpty
              ? AttractionTrainingPolicy.defaultTitle(_name.text)
              : selectedTitle;
          await (store as AttractionTrainingStore).createAttractionWithTraining(
            replacement,
            courseTitle: courseTitle,
          );
        } else {
          await widget.store.createAttraction(replacement);
        }
      } else {
        await widget.store.updateAttraction(
          original: _original!,
          replacement: replacement,
        );
      }
      if (!mounted) return;
      // Release PopScope before returning from the editor.
      setState(() => _saving = false);
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted && widget.adminAccess.value) {
          Navigator.of(context).pop(true);
        }
      });
    } on AttractionConflict catch (error) {
      if (mounted) {
        setState(() {
          _error = error.message;
          _conflict = _original != null;
        });
      }
    } on FirebaseException catch (error, stackTrace) {
      if (kDebugMode) {
        debugPrint('Attraction save failed: ${error.plugin}/${error.code}');
        debugPrintStack(stackTrace: stackTrace);
      }
      if (mounted) {
        setState(
          () => _error = switch (error.code) {
            'permission-denied' =>
              "You don't have permission to save this.",
            'unauthenticated' =>
              'Please sign in again.',
            'unavailable' || 'deadline-exceeded' =>
              'Connection failed. Try again.',
            _ =>
              "Couldn't save changes. Try again.",
          },
        );
      }
    } catch (error, stackTrace) {
      if (kDebugMode) {
        debugPrint(
          'Unexpected attraction save error (${error.runtimeType}): $error',
        );
        debugPrintStack(stackTrace: stackTrace);
      }
      if (mounted) {
        setState(
          () => _error =
              "Couldn't save changes. Try again.",
        );
      }
    } finally {
      if (mounted && _saving) setState(() => _saving = false);
    }
  }

  Future<void> _createCourseForExistingRide() async {
    if (_saving || _original == null || !widget.adminAccess.value ||
        widget.store is! AttractionTrainingStore) {
      return;
    }
    setState(() {
      _saving = true;
      _error = null;
    });
    try {
      await (widget.store as AttractionTrainingStore)
          .addRequiredTrainingToExistingRide(
        _id,
        courseTitle: AttractionTrainingPolicy.defaultTitle(_original!.name),
      );
    } on AttractionConflict catch (error) {
      if (mounted) setState(() => _error = error.message);
    } on ArgumentError catch (error) {
      if (mounted) setState(() => _error = error.message?.toString() ?? 'Check the course name.');
    } catch (_) {
      if (mounted) {
        setState(() => _error = "Couldn't add training. Try again.");
      }
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  Future<void> _reloadLatest() async {
    if (_saving || _reloading || !widget.adminAccess.value) return;
    setState(() {
      _reloading = true;
      _error = null;
    });
    try {
      final latest = await widget.store.watchAttraction(_id).first;
      if (!mounted) return;
      if (latest == null) {
        setState(
          () =>
              _error = 'This $_itemName no longer exists. Return to the list.',
        );
      } else {
        setState(() {
          _original = latest;
          _fill(latest);
          _conflict = false;
        });
      }
    } catch (_) {
      if (mounted) {
        setState(
          () => _error =
              'Unable to load the latest information. Please try again.',
        );
      }
    } finally {
      if (mounted) setState(() => _reloading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final busy = _saving || _reloading || _pickingPhoto;
    final categories = {..._categories, ?_category}.toList();
    final itemHeading =
        '${_itemName[0].toUpperCase()}${_itemName.substring(1)}';
    return AttractionAdminGuard(
      access: widget.adminAccess,
      child: PopScope(
        canPop: !busy,
        child: Scaffold(
          backgroundColor: AdminTheme.background,
          appBar: AppBar(
            title: Text(
              _original == null ? 'Add $_itemName' : 'Edit $_itemName',
            ),
            backgroundColor: AdminTheme.background,
          ),
          body: Align(
            alignment: Alignment.topCenter,
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 860),
              child: Form(
                key: _form,
                child: ListView(
                  padding: const EdgeInsets.all(20),
                  children: [
                    const SizedBox(height: 2),
                    AttractionEditorSection(
                      title: 'Attraction information',
                      description: 'The details visitors see in the app.',
                      icon: Icons.local_activity_outlined,
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                    FormField<String>(
                      key: _photoField,
                      initialValue: _cover,
                      validator: (value) =>
                          _isRide &&
                              _original == null &&
                              (value == null || value.isEmpty)
                          ? 'Add a cover photo.'
                          : null,
                      builder: (field) => Container(
                        padding: const EdgeInsets.all(18),
                        decoration: BoxDecoration(
                          color: Colors.white,
                          borderRadius: BorderRadius.circular(10),
                          border: Border.all(
                            color: field.hasError
                                ? Theme.of(context).colorScheme.error
                                : AdminTheme.border,
                          ),
                        ),
                        child: Wrap(
                          spacing: 20,
                          runSpacing: 12,
                          crossAxisAlignment: WrapCrossAlignment.center,
                          children: [
                            AttractionCover(
                              encoded: _cover,
                              width: 150,
                              height: 150,
                            ),
                            Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                Text(
                                  _isRide
                                      ? 'Customer cover photo'
                                      : 'Cover photo (optional)',
                                  style: const TextStyle(
                                    fontSize: 17,
                                    fontWeight: FontWeight.w600,
                                  ),
                                ),
                                const SizedBox(height: 6),
                                const Text(
                                  'JPG, PNG or WebP · up to 8 MB',
                                  style: TextStyle(
                                    fontSize: 12,
                                    color: AdminTheme.muted,
                                  ),
                                ),
                                const SizedBox(height: 12),
                                OutlinedButton.icon(
                                  onPressed: busy ? null : _pickPhoto,
                                  icon: const Icon(
                                    Icons.add_photo_alternate_outlined,
                                  ),
                                  label: Text(
                                    _pickingPhoto
                                        ? 'Processing photo…'
                                        : _cover == null
                                        ? 'Choose cover photo'
                                        : 'Replace cover photo',
                                  ),
                                ),
                                if (field.hasError)
                                  Padding(
                                    padding: const EdgeInsets.only(top: 8),
                                    child: Text(
                                      field.errorText!,
                                      style: TextStyle(
                                        color: Theme.of(
                                          context,
                                        ).colorScheme.error,
                                      ),
                                    ),
                                  ),
                              ],
                            ),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(height: 22),
                    TextFormField(
                      controller: _name,
                      enabled: !busy,
                      onChanged: _isRide ? (_) => setState(() {}) : null,
                      maxLength: 80,
                      decoration: InputDecoration(
                        labelText: '$itemHeading name',
                        border: const OutlineInputBorder(),
                      ),
                      validator: (value) =>
                          value == null || value.trim().isEmpty
                          ? (_isRide
                                ? 'Enter an attraction name.'
                                : 'Enter a name.')
                          : null,
                    ),
                    const SizedBox(height: 14),
                    TextFormField(
                      controller: _description,
                      enabled: !busy,
                      minLines: 3,
                      maxLines: 5,
                      maxLength: 1200,
                      decoration: InputDecoration(
                        labelText: '$itemHeading description',
                        hintText: _isRide
                            ? 'Describe the experience, safety guidance and what visitors should know.'
                            : 'Tell visitors what they can find here.',
                      ),
                      validator: (value) =>
                          value == null || value.trim().isEmpty
                          ? (_isRide
                                ? 'Enter an attraction description.'
                                : 'Enter a description.')
                          : null,
                    ),
                    const SizedBox(height: 14),
                    if (_isRide)
                      DropdownButtonFormField<String>(
                        isExpanded: true,
                        key: ValueKey('editor-category-$_category'),
                        initialValue: _category,
                        decoration: const InputDecoration(
                          labelText: 'Category',
                          border: OutlineInputBorder(),
                        ),
                        items: [
                          for (final category in categories)
                            DropdownMenuItem(
                              value: category,
                              child: Text(category),
                            ),
                        ],
                        onChanged: busy
                            ? null
                            : (value) => setState(() => _category = value),
                        validator: (value) =>
                            value == null ? 'Choose a category.' : null,
                      )
                    else
                      InputDecorator(
                        decoration: const InputDecoration(
                          labelText: 'Facility type',
                        ),
                        child: Text(_kind.label),
                      ),
                    const SizedBox(height: 20),
                        ],
                      ),
                    ),
                    if (_isRide) ...[
                      const SizedBox(height: 22),
                      AttractionEditorSection(
                        title: 'Ride details & safety',
                        description: 'Safety rules and equipment limits.',
                        icon: Icons.shield_outlined,
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.stretch,
                          children: [
                            TextFormField(
                              controller: _height,
                              enabled: !busy,
                              keyboardType: TextInputType.number,
                              decoration: const InputDecoration(
                                labelText: 'Minimum rider height (cm)',
                                helperText: 'Enter 0 if there is no height restriction.',
                              ),
                              validator: (value) {
                                final v = int.tryParse(value?.trim() ?? '');
                                return v == null || v < 0 || v > 250
                                    ? 'Enter a height between 0 and 250 cm.' : null;
                              },
                            ),
                            const SizedBox(height: 14),
                            TextFormField(
                              controller: _duration,
                              enabled: !busy,
                              keyboardType: TextInputType.number,
                              decoration: const InputDecoration(
                                labelText: 'Ride duration (minutes) *',
                                hintText: 'e.g. 5',
                              ),
                              validator: (value) {
                                if (_original != null && (value ?? '').trim().isEmpty) return null;
                                final v = int.tryParse(value?.trim() ?? '');
                                return v == null || v < 1 || v > 120
                                    ? 'Enter a duration from 1 to 120 minutes.' : null;
                              },
                            ),
                            const SizedBox(height: 14),
                            TextFormField(
                              controller: _riders,
                              enabled: !busy,
                              keyboardType: TextInputType.number,
                              decoration: const InputDecoration(
                                labelText: 'Riders per cycle *',
                                hintText: 'e.g. 24',
                                helperText: 'The physical ride capacity, not booking slots.',
                              ),
                              validator: (value) {
                                if (_original != null && (value ?? '').trim().isEmpty) return null;
                                final v = int.tryParse(value?.trim() ?? '');
                                return v == null || v < 1 || v > 1000
                                    ? 'Enter a capacity from 1 to 1000.' : null;
                              },
                            ),
                            const SizedBox(height: 14),
                            TextFormField(
                              controller: _safetyNotes,
                              enabled: !busy,
                              minLines: 2,
                              maxLines: 4,
                              maxLength: 500,
                              decoration: const InputDecoration(
                                labelText: 'Safety instructions (optional)',
                                hintText: 'e.g. Remain seated until the ride stops.',
                              ),
                            ),
                            if (_original == null) const Padding(
                              padding: EdgeInsets.only(top: 8),
                              child: Text('New attractions start Closed until the team approves opening.',
                                  style: TextStyle(color: AdminTheme.muted, fontSize: 12)),
                            ),
                          ],
                        ),
                      ),
                    ],
                    if (_isRide) ...[
                      const SizedBox(height: 20),
                      Container(
                        padding: const EdgeInsets.all(20),
                        decoration: BoxDecoration(
                          color: Colors.white,
                          border: Border.all(color: AdminTheme.border),
                          borderRadius: BorderRadius.circular(10),
                          boxShadow: const [BoxShadow(
                            color: Color(0x09000000),
                            blurRadius: 12,
                            offset: Offset(0, 3),
                          )],
                        ),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            const Row(children: [
                              Icon(Icons.school_outlined,
                                  color: AdminTheme.rose, size: 22),
                              SizedBox(width: 10),
                              Text('Required operator training',
                                style: TextStyle(fontSize: 18,
                                    fontWeight: FontWeight.w700)),
                            ]),
                            const SizedBox(height: 8),
                            const Text(
                              'Staff must complete this course before being assigned to this ride.',
                              style: TextStyle(color: AdminTheme.muted,
                                  fontSize: 13),
                            ),
                            const SizedBox(height: 14),
                            if (_original == null) ...[
                              TextFormField(
                                controller: _trainingTitle,
                                enabled: !busy,
                                maxLength: 120,
                                decoration: InputDecoration(
                                  labelText: 'Course name (optional)',
                                  hintText: _name.text.trim().isEmpty
                                      ? 'e.g. Ferris Wheel Operation & Safety Training'
                                      : AttractionTrainingPolicy.defaultTitle(_name.text),
                                  helperText: 'Leave blank to create the course automatically.',
                                ),
                                validator: (value) {
                                  if ((value ?? '').trim().isEmpty) return null;
                                  return AttractionTrainingPolicy.validateTitle(value);
                                },
                              ),
                              Text(
                                'The course will be linked to this attraction automatically.',
                                style: const TextStyle(fontSize: 12,
                                    color: AdminTheme.muted),
                              ),
                            ] else if (widget.store is AttractionTrainingStore)
                              StreamBuilder<List<String>>(
                                stream: (widget.store as AttractionTrainingStore)
                                    .watchRequiredTraining(_id),
                                builder: (context, snapshot) {
                                  if (snapshot.hasError) {
                                    return const Text("Couldn't load training courses.",
                                      style: TextStyle(color: Color(0xFFB42318)));
                                  }
                                  if (!snapshot.hasData) {
                                    return const LinearProgressIndicator();
                                  }
                                  final titles = snapshot.data!;
                                  if (titles.isEmpty) {
                                    return Column(
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        const Text('No training course linked yet.'),
                                        const SizedBox(height: 10),
                                        OutlinedButton.icon(
                                          onPressed: busy ? null :
                                              _createCourseForExistingRide,
                                          icon: const Icon(Icons.add),
                                          label: const Text('Create required course'),
                                        ),
                                      ],
                                    );
                                  }
                                  return Column(
                                    crossAxisAlignment: CrossAxisAlignment.start,
                                    children: [
                                      for (final title in titles)
                                        Padding(
                                          padding: const EdgeInsets.symmetric(vertical: 4),
                                          child: Row(children: [
                                            const Icon(Icons.check_circle_outline,
                                              color: Color(0xFF27734F), size: 18),
                                            const SizedBox(width: 9),
                                            Expanded(child: Text(title)),
                                          ]),
                                        ),
                                    ],
                                  );
                                },
                              ),
                          ],
                        ),
                      ),
                    ],
                    const SizedBox(height: 22),
                    AttractionEditorSection(
                      title: 'Location on park map',
                      description: 'Place a pin where guests will find this attraction.',
                      icon: Icons.location_on_outlined,
                      child: FormField<Offset>(
                        initialValue: _mapX.text.isNotEmpty && _mapY.text.isNotEmpty &&
                                (double.tryParse(_mapX.text) ?? -1) >= 0 &&
                                (double.tryParse(_mapX.text) ?? 2) <= 1 &&
                                (double.tryParse(_mapY.text) ?? -1) >= 0 &&
                                (double.tryParse(_mapY.text) ?? 2) <= 1
                            ? Offset(double.parse(_mapX.text), double.parse(_mapY.text))
                            : null,
                        validator: (value) => value == null
                            ? 'Choose a location on the map.' : null,
                        builder: (field) => Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            StreamBuilder<List<Attraction>>(
                              stream: widget.store.watchAttractions(),
                              builder: (context, snapshot) => AttractionMapPicker(
                                position: field.value,
                                places: snapshot.data ?? const [],
                                excludeId: _id,
                                onChanged: busy ? null : (point) {
                                  field.didChange(point);
                                  _mapX.text = point.dx.toStringAsFixed(6);
                                  _mapY.text = point.dy.toStringAsFixed(6);
                                },
                              ),
                            ),
                            if (field.hasError) Padding(
                              padding: const EdgeInsets.only(top: 9),
                              child: Text(field.errorText!,
                                style: const TextStyle(color: Color(0xFFB42318), fontSize: 12)),
                            ),
                          ],
                        ),
                      ),
                    ),
                    if (_isRide) ...[
                      const SizedBox(height: 22),
                      AttractionEditorSection(
                        title: 'Booking settings',
                        description: 'Control advance reservations, not the physical ride capacity.',
                        icon: Icons.event_available_outlined,
                        child: TextFormField(
                          controller: _capacity,
                          enabled: !busy,
                          keyboardType: TextInputType.number,
                          decoration: const InputDecoration(
                            labelText: 'Max bookings per 15-minute slot',
                          ),
                          validator: (value) {
                            final v = int.tryParse(value?.trim() ?? '');
                            return v == null || v < 1 || v > 1000
                                ? 'Enter a capacity from 1 to 1000.' : null;
                          },
                        ),
                      ),
                    ],
                    if (_original != null) ...[
                      const SizedBox(height: 22),
                      AttractionEditorSection(
                        title: 'Operating status',
                        description: 'Change whether this attraction is available to guests.',
                        icon: Icons.toggle_on_outlined,
                        child:
                    DropdownButtonFormField<AttractionStatus>(
                      isExpanded: true,
                      key: ValueKey('editor-status-${_status.name}'),
                      initialValue: _status,
                      decoration: InputDecoration(
                        labelText: _isRide ? 'Ride status' : 'Status',
                        border: const OutlineInputBorder(),
                      ),
                      items: [
                        for (final status in AttractionStatus.values)
                          DropdownMenuItem(
                            value: status,
                            child: Text(attractionStatusLabel(status)),
                          ),
                      ],
                      onChanged: busy
                          ? null
                          : (value) => setState(() => _status = value!),
                    ),
                      ),
                    ],
                    const SizedBox(height: 22),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.end,
                      children: [
                        OutlinedButton(
                          onPressed: busy ? null : () => Navigator.of(context).pop(false),
                          child: const Text('Cancel'),
                        ),
                        const SizedBox(width: 12),
                        FilledButton.icon(
                          onPressed: busy ? null : _save,
                          style: FilledButton.styleFrom(
                            backgroundColor: AdminTheme.rose,
                            minimumSize: const Size(170, 46),
                          ),
                          icon: busy
                              ? const SizedBox(width: 17, height: 17,
                                  child: CircularProgressIndicator(strokeWidth: 2))
                              : const Icon(Icons.save_outlined),
                          label: Text(_saving ? 'Saving...' : _reloading
                              ? 'Loading...' : 'Save $_itemName'),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }
}
